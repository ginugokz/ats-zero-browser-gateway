              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "6f1d2a10-0000-4000-8000-000000000006",
      "name": "Format closed job",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1220, 380]
    },
    {
